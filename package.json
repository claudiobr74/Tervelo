{
  "name": "tervelo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:deploy": "tsx scripts/smoke-deploy.ts",
    "metadata:generate": "tsx scripts/generate-hasura-metadata.ts",
    "nhost:up": "nhost up",
    "nhost:down": "nhost down",
    "nhost:jwt": "bash scripts/generate-nhost-jwt.sh",
    "catalog:gifs": "node scripts/gifdotreino-downloader/download_gifdotreino.mjs",
    "catalog:gifs:probe": "node scripts/gifdotreino-downloader/download_gifdotreino.mjs --limit 5",
    "catalog:gifs:headed": "node scripts/gifdotreino-downloader/download_gifdotreino.mjs --browser --headed --limit 5",
    "catalog:gifs:debug": "node scripts/gifdotreino-downloader/download_gifdotreino.mjs --browser --headed --slow 250 --limit 5",
    "catalog:descriptions": "node scripts/gifdotreino-downloader/fetch_descriptions.mjs",
    "catalog:media-seed": "node scripts/gifdotreino-downloader/generate_media_seed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nhost/nhost-js": "^4.7.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.544.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nhost/cli": "^1.50.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
