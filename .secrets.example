# Secrets locais da CLI Nhost (`nhost up` / `nhost config validate`).
# Copiar para `.secrets` na raiz. Nunca commitar valores reais.
# JWT de verdade: `npm run nhost:jwt` (openssl). Não cole os placeholders
# abaixo no Cloud — PEM truncada faz o hasura-auth sair com exit 1.
#
# O Nhost já cria: HASURA_GRAPHQL_ADMIN_SECRET, NHOST_WEBHOOK_SECRET,
# GRAFANA_ADMIN_PASSWORD.

HASURA_GRAPHQL_ADMIN_SECRET="change-me-admin"
NHOST_WEBHOOK_SECRET="change-me-webhook"
GRAFANA_ADMIN_PASSWORD="change-me-grafana"
NHOST_JWT_KID="run-npm-run-nhost-jwt"
NHOST_JWT_PUBLIC_KEY="run-npm-run-nhost-jwt"
NHOST_JWT_PRIVATE_KEY="run-npm-run-nhost-jwt"
