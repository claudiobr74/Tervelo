# Secrets locais da CLI Nhost (`nhost up` / `nhost config validate`).
# Copiar para `.secrets` na raiz. Nunca commitar valores reais.
# No Cloud: Settings → Secrets — os nomes abaixo precisam existir
# (exceto os que o Nhost já cria: HASURA_GRAPHQL_ADMIN_SECRET,
# NHOST_WEBHOOK_SECRET, GRAFANA_ADMIN_PASSWORD).
#
# Valores entre aspas. `nhost init` / `nhost up` geram o par JWT de verdade.

HASURA_GRAPHQL_ADMIN_SECRET="change-me-admin"
NHOST_WEBHOOK_SECRET="change-me-webhook"
GRAFANA_ADMIN_PASSWORD="change-me-grafana"
NHOST_JWT_KID="local-dev-kid"
NHOST_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAu1SU1LfVLPHCozMxH2Mo\n4lgOEePzNm0tRgeLez4p6kA/1qKkQwIDAQAB\n-----END PUBLIC KEY-----"
NHOST_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKj\nMzEfYyjiWA4R4/M2bS1GB4t7PinqQD/WoqRDAgMBAAE=\n-----END PRIVATE KEY-----"
