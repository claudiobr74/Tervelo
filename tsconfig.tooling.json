{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "incremental": false,
    // `scripts/` roda via tsx, que resolve o caminho com extensão .ts.
    "allowImportingTsExtensions": true
  },
  "include": ["e2e/**/*.ts", "scripts/**/*.ts", "functions/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
