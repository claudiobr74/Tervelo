# Copiar para `.env.local`. Nunca commitar `.env` nem secrets.

# Públicos — únicos permitidos no bundle do cliente
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# Somente servidor / CI / `nhost` CLI — NUNCA NEXT_PUBLIC_
# NHOST_ADMIN_SECRET=
# NHOST_GRAPHQL_URL=

# Roles de produto: user (atleta) e admin (administrador).
# Promover admin: INSERT em auth.user_roles no banco, nunca pelo cliente.
